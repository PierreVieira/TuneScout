<?xml version="1.0" encoding="utf-8"?><!--
    Nothing the app stores is backed up or carried to a new device. The Room database holds a cache
    of iTunes results and of what was played recently, which is re-fetchable, but also the
    playlists, liked songs and liked albums the user created, which are not: they are lost on a
    reinstall or a new device. `android:allowBackup="false"` already rules out cloud backup, but on
    Android 12+ it does not reliably stop device-to-device transfer, so both channels are excluded
    explicitly here.

    Excluding each storage root covers its subdirectories (files, databases and shared preferences).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
