<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Only the home screen host talks to these, through the AppWidget framework, so neither is
          exported: the system has the permission it needs without opening them to other apps.
        -->
        <receiver
            android:name=".presentation.widget.NowPlayingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_now_playing_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.NowPlayingShortcutsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_now_playing_shortcuts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_shortcuts_widget_info" />
        </receiver>
    </application>

</manifest>
