<?xml version="1.0" encoding="utf-8"?>
<!--
    The picker preview of the two-row widget below Android 15, approximating
    NowPlayingShortcutsWidgetContent. On Android 15+ the preview Glance renders takes precedence
    over it.

    The icons are tinted with android:tint, not app:tint: RemoteViews inflates the layout without
    AppCompat, so app:tint would be ignored.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/widget_preview_labels" />

            <include
                layout="@layout/widget_preview_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <include layout="@layout/widget_preview_controls" />
        </LinearLayout>
    </LinearLayout>

    <!-- One tile per WidgetState.SHORTCUT_COUNT. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_artwork">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_song_placeholder"
                android:tint="@color/widget_preview_element_disabled" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
