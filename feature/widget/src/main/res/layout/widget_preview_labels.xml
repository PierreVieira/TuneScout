<?xml version="1.0" encoding="utf-8"?>
<!-- WidgetSongLabelsComponent, drawn with the sample song of WidgetPreviewContentFactory. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_preview_song_title"
        android:textColor="@color/widget_preview_text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_song_artist"
        android:textColor="@color/widget_preview_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
