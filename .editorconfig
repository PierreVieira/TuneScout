# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Kotlin files
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_standard_function-naming = disabled
ktlint_standard_filename = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_when-entry-bracing = disabled
ktlint_standard_no-unused-imports = enabled
ktlint_function_signature_body_expression_wrapping = default

# Test sources: fixtures and fakes are named after the value they produce
# (song(), songDto(), album()), which is intentional and reads well in Given/When/Then.
[**/src/{test,androidTest}/**]
ktlint_tunescout-style_value-returning-function-naming = disabled
ktlint_tunescout-style_top-level-function-ownership = disabled

# The screenshot fixtures ship to both screenshot suites from main sources, for the same reason
[tools/screenshot_fixtures/src/**]
ktlint_tunescout-style_value-returning-function-naming = disabled
ktlint_tunescout-style_top-level-function-ownership = disabled

# core/testing ships fixtures to other modules' tests, so the same naming applies to its main sources
[core/testing/src/**]
ktlint_tunescout-style_value-returning-function-naming = disabled
ktlint_tunescout-style_top-level-function-ownership = disabled

# Build scripts are configuration, not declarations: there is nothing for a KDoc to attach to
[*.kts]
ktlint_tunescout-style_kdoc-only-comments = disabled

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Gradle files
[*.{gradle,gradle.kts}]
indent_style = space
indent_size = 4

[**/generated/**]
generated_code = true
ij_formatter_enabled = false
ktlint = disabled

[**/build/**]
generated_code = true
ij_formatter_enabled = false
ktlint = disabled
